<?xml version="1.0" encoding="utf-8"?>
<!-- Approval card: the agent proposes a change in plain words. Nothing
     runs until the user taps Approve; the outcome stays on the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="18dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/approval_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLargeEmphasized"
                tools:text="Add a screen to Sporty Bet" />

            <TextView
                android:id="@+id/approval_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="New activity: SettingsActivity" />

            <TextView
                android:id="@+id/approval_details_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="2dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="Details ▾" />

            <TextView
                android:id="@+id/approval_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Adds one empty screen."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/approval_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/approval_approve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_approval_approve"
                    app:backgroundTint="@color/agent_approve_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/approval_reject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/agent_approval_reject"
                    app:backgroundTint="@color/agent_reject_red" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/approval_state_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/approval_dot_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/agent_typing_dot" />

                <View
                    android:id="@+id/approval_dot_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/agent_typing_dot" />

                <View
                    android:id="@+id/approval_dot_3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/agent_typing_dot" />

                <TextView
                    android:id="@+id/approval_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Working…" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
