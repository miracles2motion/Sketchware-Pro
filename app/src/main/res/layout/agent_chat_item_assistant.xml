<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/message_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="18dp">

        <LinearLayout
            android:id="@+id/message_content_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Reasoning, when the model showed any: a quiet header over
                 a collapsed body. Absent entirely for models that do not
                 think out loud. -->
            <TextView
                android:id="@+id/thinking_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="2dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="Thinking ▾"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/thinking_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="The summary confirms two screens."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                tools:text="I'll start by creating the project and a login screen." />

            <LinearLayout
                android:id="@+id/openui_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Typing indicator on its own: a small pill under the bubble, shown
         from send until the reply is complete. Never inside the bubble. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/typing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="14dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <View
                android:id="@+id/dot_1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/agent_typing_dot" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/agent_typing_dot" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/agent_typing_dot" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Only for a failed turn: quietly offers to send it again. -->
    <TextView
        android:id="@+id/retry_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:text="@string/agent_action_retry"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
